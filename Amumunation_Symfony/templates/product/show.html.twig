{% extends 'base.html.twig' %}

{% block title %}{{ product.name }} - Ammunition Shop{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row">
        <div class="col-lg-8 offset-lg-2">
            <a href="{{ path('app_products') }}" class="btn btn-secondary mb-3">← Retour aux produits</a>
            
            <div class="card">
                <div class="card-body">
                    <h1>{{ product.name }}</h1>
                    <p class="text-muted">{{ product.category }}</p>
                    
                    <hr>
                    
                    <h3 class="text-primary">{{ product.price }}€</h3>
                    
                    <div class="mt-4">
                        <h5>Description</h5>
                        <p>{{ product.description }}</p>
                    </div>

                    <div class="mt-4">
                        <h5>Détails</h5>
                        <ul>
                            <li><strong>Catégorie:</strong> {{ product.category }}</li>
                            <li><strong>Stock disponible:</strong> {{ product.stock }} unités</li>
                            <li><strong>Évaluation:</strong> {{ product.reviews }}/5</li>
                        </ul>
                    </div>

                    <div class="mt-5">
                        <form method="POST" action="{{ path('app_cart_add', {'id': product.id}) }}">
                            <div class="mb-3">
                                <label for="quantity" class="form-label">Quantité</label>
                                <input type="number" class="form-control" id="quantity" name="quantity" value="1" min="1" max="{{ product.stock }}">
                            </div>
                            <button type="submit" class="btn btn-primary btn-lg">Ajouter au panier</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
