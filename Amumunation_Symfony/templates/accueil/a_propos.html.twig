{% extends 'base.html.twig' %}

{% block title %}À propos - AmumuNation{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row">
        <div class="col-lg-8 offset-lg-2">
            <h1>À propos d'AmumuNation</h1>
            <hr>
            
            <h2 class="mt-4">Notre mission</h2>
            <p>AmumuNation est la plateforme de référence pour les collectionneurs d'armes et d'objets inspirés de jeux vidéo. Nous proposons un marché sécurisé où les passionnés peuvent acheter, vendre et échanger leurs pièces de collection.</p>
            
            <h2 class="mt-4">Pourquoi nous choisir ?</h2>
            <ul class="list-group list-group-flush">
                <li class="list-group-item">✓ Plateforme sécurisée et de confiance</li>
                <li class="list-group-item">✓ Vérification des vendeurs</li>
                <li class="list-group-item">✓ Protection des acheteurs</li>
                <li class="list-group-item">✓ Large sélection d'armes et d'objets inspirés de vos univers favoris</li>
                <li class="list-group-item">✓ Prix compétitifs</li>
                <li class="list-group-item">✓ Livraison rapide et sécurisée</li>
            </ul>

            <h2 class="mt-4">Nos jeux partenaires</h2>
            <p>CS:GO • Valorant • Fortnite • PUBG • Call of Duty • Warzone</p>

            <div class="mt-5">
                <a href="{{ path('accueil') }}" class="btn btn-secondary">Retour à l'accueil</a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
