{% extends 'base.html.twig' %}

{% block title %}{{ annonce.nom }} - AmumuNation{% endblock %}

{% block body %}
<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('accueil') }}">Accueil</a></li>
            <li class="breadcrumb-item"><a href="{{ path('annonces') }}">Annonces</a></li>
            <li class="breadcrumb-item active">{{ annonce.nom }}</li>
        </ol>
    </nav>

    <div class="row mt-4">
        <div class="col-lg-6">
            <div class="product-gallery">
                {% if annonce.image %}
                    <img src="{{ asset('img_armes/' ~ annonce.image) }}" alt="{{ annonce.nom }}" style="width: 100%; height: auto; border-radius: 8px;">
                {% else %}
                    <div class="bg-light d-flex align-items-center justify-content-center" style="width: 100%; height: 400px; border-radius: 8px;">
                        <span class="text-muted">Pas d'image</span>
                    </div>
                {% endif %}
            </div>
        </div>

        <div class="col-lg-6">
            <div class="product-details">
                <h1>{{ annonce.nom }}</h1>
                <hr>
                <div class="price-section mb-3">
                    <h2 class="price text-danger">{{ annonce.prix }}€</h2>
                </div>
                <div class="info-box bg-light p-3 rounded mb-3">
                    <div class="info-row mb-2">
                        <span class="label fw-bold">Rareté :</span>
                        <span class="badge bg-info">{{ annonce.rarete }}</span>
                    </div>
                    <div class="info-row">
                        <span class="label fw-bold">Vendeur :</span>
                        <span class="value"><strong>{{ annonce.vendeur.pseudo }}</strong></span>
                    </div>
                </div>
                <div class="description-box mb-4">
                    <h4>Description</h4>
                    <p>{{ annonce.description }}</p>
                </div>
                <div class="actions mt-3">
                    <form action="{{ path('app_cart_add', {'id': annonce.idProduit}) }}" method="post" class="mb-2">
                        <button type="submit" class="btn btn-danger btn-lg w-100">Ajouter au panier</button>
                    </form>
                    <a href="{{ path('annonces') }}" class="btn btn-outline-secondary w-100">Retour aux annonces</a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block stylesheets %}
<style>
    .product-gallery {
        position: sticky;
        top: 100px;
    }

    .main-image {
        width: 100%;
        aspect-ratio: 1;
        background: #f5f5f5;
        border: 1px solid #ddd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 120px;
        margin-bottom: 15px;
        border-radius: 8px;
    }

    .thumbnails {
        display: flex;
        gap: 10px;
    }

    .thumbnail {
        width: 80px;
        height: 80px;
        background: #f5f5f5;
        border: 1px solid #ddd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 40px;
        cursor: pointer;
        border-radius: 4px;
    }

    .product-details h1 {
        font-size: 28px;
        margin-bottom: 15px;
    }

    .rating-section {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 20px;
    }

    .price {
        color: #e47911;
        font-size: 32px;
        font-weight: bold;
    }

    .info-box {
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 20px;
        background: #fafafa;
    }

    .info-row {
        display: flex;
        justify-content: space-between;
        padding: 10px 0;
        border-bottom: 1px solid #eee;
    }

    .info-row:last-child {
        border-bottom: none;
    }

    .label {
        font-weight: 600;
        color: #333;
    }

    .value {
        color: #666;
    }

    .seller-card {
        border: 1px solid #ddd;
        padding: 15px;
        border-radius: 8px;
        background: #fafafa;
    }
</style>
{% endblock %}
